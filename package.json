{
  "name": "gymplan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "emulators": "JAVA_HOME=$(/usr/libexec/java_home -v 21) firebase emulators:start --only auth,firestore --project demo-gymplan --import=.emulator-data --export-on-exit",
    "dev:user": "node scripts/dev-user.mjs",
    "test:rules": "JAVA_HOME=$(/usr/libexec/java_home -v 21) firebase emulators:exec --only firestore --project demo-gymplan 'vitest run tests'",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
