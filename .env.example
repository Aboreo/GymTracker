# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# These values are not secret, but .env is kept out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev only: set to false to run `npm run dev` against the real project instead of the emulators.
VITE_USE_EMULATORS=true
