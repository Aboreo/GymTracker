rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // OWNER ALLOW-LIST
    // Replace REPLACE_WITH_YOUR_UID with your uid (Firebase console → Authentication → Users → User UID).
    // 'dev-owner' is the local emulator account created by `npm run dev:user`. It cannot be
    // created through email/password sign-up in production (those uids are random), so it is harmless.
    function allowedUid(uid) {
      return uid in ['dev-owner', 'REPLACE_WITH_YOUR_UID'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && allowedUid(uid);
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
